# -----------------------------------------------------------------------------
# Example Environment Variables
#
# Copy this file to a new file named .env and fill in your actual values.
# This file is used by docker-compose to configure the services.
# -----------------------------------------------------------------------------

# -- PostgreSQL Database --
# These credentials are used by the postgres container and the backend service.
POSTGRES_DB=aiparser
POSTGRES_USER=user
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql://user:password@postgres:5432/aiparser

# -- Redis Cache & Broker --
# URL for the Redis container, used by the backend and celery worker.
REDIS_URL=redis://redis:6379

# -- Backend JWT Settings --
# IMPORTANT: Change this to a long, random, and secret string in your .env file.
JWT_SECRET_KEY=a_very_secret_key_that_should_be_changed_in_production

# -- AI Service Keys --
# Your API key for the OpenAI service.
OPENAI_API_KEY=sk-your-openai-api-key-here

# -- S3/MinIO Storage --
# These are not used in the current dev setup (no MinIO service defined),
# but are required by the backend's settings model.
# You can leave them as-is for now.
S3_BUCKET=ai-pdf-parser
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# -- Frontend --
# The public URL for the backend API, used by the Next.js application.
# This must be accessible from the user's browser.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
